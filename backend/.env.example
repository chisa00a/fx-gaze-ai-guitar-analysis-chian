# FxGaze backend configuration (copy to /etc env or shell profile)

# Celery / Redis — เริ่ม Redis ด้วย `docker compose up -d redis`
FXGAZE_BROKER_URL=redis://localhost:6379/0
FXGAZE_RESULT_BACKEND=redis://localhost:6379/1
# ตั้ง 1 เพื่อบังคับรัน task แบบ in-process (ไม่ต้องมี Redis) สำหรับทดสอบ
FXGAZE_CELERY_EAGER=0

# โฟลเดอร์เก็บไฟล์เสียงและผลลัพธ์
FXGAZE_UPLOAD_DIR=.uploads
FXGAZE_RESULTS_DIR=.results

# ข้อจำกัดเสียง (NFR-01: คลิปไม่เกิน 15 วิ)
FXGAZE_MAX_AUDIO_SECONDS=15
FXGAZE_MAX_UPLOAD_BYTES=26214400

# Ollama / Pathumma 8B (FR-05, NFR-03 Local only)
FXGAZE_OLLAMA_URL=http://127.0.0.1:11434
FXGAZE_OLLAMA_MODEL=pathumma-thaillm-8b-think:Q4_K_M
FXGAZE_OLLAMA_TIMEOUT=120

# FR-03: แยกเสียงกีตาร์ด้วย demucs (ต้อง pip install demucs torch ก่อน)
FXGAZE_ENABLE_DEMUCS=0
